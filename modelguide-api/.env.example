PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://modelguide:modelguide@localhost:5434/modelguide
MCP_SERVER_NAME=ModelGuide MCP
MCP_SERVER_VERSION=1.0.0

# Authentication
# JWT secret for access tokens - minimum 32 characters
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m

# Refresh token secret (MUST be different from JWT_SECRET) - minimum 32 characters
# Generate with: openssl rand -hex 32
REFRESH_JWT_SECRET=your-refresh-jwt-secret-min-32-chars-here
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_SESSION_RETENTION_DAYS=90

# Encryption key for secrets (32 bytes, base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY=

# Frontend origin — used for CSRF validation and cookie security (not the API listen address)
APP_URL=http://localhost:3001
MAGIC_LINK_EXPIRES_IN_MINUTES=15
# HMAC secret for hashing magic tokens (minimum 32 characters)
# Generate with: openssl rand -hex 32
MAGIC_LINK_SECRET=dev-magic-link-secret-minimum-32-chars-long
# Delivery strategy: "console" (dev) or "resend" (production)
MAGIC_LINK_STRATEGY=console
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com
