PORT=3000
NODE_ENV=development
# Log level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
DATABASE_URL=postgresql://modelguide_app:modelguide_app@localhost:5434/modelguide
DATABASE_MIGRATION_URL=postgresql://modelguide:modelguide@localhost:5434/modelguide
MCP_SERVER_NAME=ModelGuide MCP
MCP_SERVER_VERSION=1.0.0

# Authentication
# JWT secret for access tokens - minimum 32 characters
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m

# Refresh token secret (MUST be different from JWT_SECRET) - minimum 32 characters
# Generate with: openssl rand -hex 32
REFRESH_JWT_SECRET=your-refresh-jwt-secret-min-32-chars-here
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_SESSION_RETENTION_DAYS=90

# Encryption key for secrets (any string, minimum 32 characters)
# The key is hashed with SHA-256 to derive the AES-256 encryption key
ENCRYPTION_KEY=change-me-to-a-long-random-secret-string

# Frontend origin — used for CSRF validation and cookie security (not the API listen address)
APP_URL=http://localhost:3001
MAGIC_LINK_EXPIRES_IN_MINUTES=15
# HMAC secret for hashing magic tokens (minimum 32 characters)
# Generate with: openssl rand -hex 32
MAGIC_LINK_SECRET=dev-magic-link-secret-minimum-32-chars-long
# Delivery strategy: "console" (dev) or "resend" (production)
MAGIC_LINK_STRATEGY=console
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# Public API address for external services (e.g., Railway load balancer URL)
# Used for ElevenLabs sync (MCP server URL, webhook URL). Falls back to APP_URL.
# API_EXTERNAL_ADDRESS=https://your-app.up.railway.app

# CORS allowed origins (comma-separated). Leave empty to disable.
# CORS_ORIGINS=http://localhost:5173,https://demo.example.com

# Persona simulation — LLM provider for synthetic customer conversations
# Supports any OpenAI-compatible API (OpenAI, Azure, etc.)
# SIMULATION_LLM_API_KEY=sk-xxxxxxxxxxxx
# SIMULATION_LLM_MODEL=gpt-5-mini
# SIMULATION_LLM_BASE_URL=https://api.openai.com/v1
# SIMULATION_MAX_TURNS=20
# SIMULATION_TIMEOUT_MS=120000
# LLM model for the simulated agent (Vercel AI SDK format: "provider/model")
# Different from SIMULATION_LLM_MODEL which drives persona/personalization
# SIMULATION_AGENT_MODEL=anthropic/claude-haiku-4-5-20251001

# Evals & SOP classification — LLM judge for automated evaluation scoring
# Supports OpenAI-compatible and Anthropic APIs (auto-detected from base URL)
# EVAL_LLM_API_KEY=sk-xxxxxxxxxxxx
# EVAL_LLM_MODEL=o4-mini
# EVAL_LLM_BASE_URL=https://api.openai.com/v1

# Test case generation — Anthropic API for synthetic test case generation
# Uses Vercel AI SDK generateObject() with @ai-sdk/anthropic provider
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# GENERATION_DIMENSION_MODEL=claude-sonnet-4-20250514
# GENERATION_CASE_MODEL=claude-haiku-4-5-20251001
