{
  "name": "modelguide-api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "test:unit": "bun test --preload ./tests/setup/unit-preload.ts tests/unit",
    "test:integration": "bun test --preload ./tests/setup/integration-preload.ts tests/integration",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed/index.ts",
    "sync:connectors": "bun run src/features/connectors/catalog/sync.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.34.0",
    "@hono/zod-openapi": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@scalar/hono-api-reference": "^0.5.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "postgres": "^3.4.0",
    "resend": "^6.9.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.0",
    "testcontainers": "^11.11.0",
    "typescript": "^5.7.0"
  }
}
