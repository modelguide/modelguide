# API Configuration
# URL for UI to make API requests (can be relative path or proxied URL)
VITE_API_URL=http://localhost:8000/api

# Public-facing API URL for webhook URLs displayed in the UI
# This is the URL that external services (e.g., ElevenLabs) should use to call webhooks
# In production, set this to your public API URL (e.g., https://api.yourdomain.com)
# Should match the API's API_EXTERNAL_ADDRESS
VITE_PUBLIC_API_URL=http://localhost:3000

# Feature Flags (optional)
VITE_ENABLE_DEVTOOLS=true