# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Resend (email delivery)
RESEND_API_KEY=re_your-key-here

# Server
PORT=3000

# Inbox filter — only emails addressed to this address will be processed; all others are skipped
INBOX_EMAIL=support@yourdomain.com

# ModelGuide MCP Configuration
# MCP_SERVER_URL: full endpoint URL including agent path (/mcp/<agentId>)
# MCP_API_KEY:    agent API key (mgk_...) — used for MCP calls AND post-call webhook auth
# ORDER_LOOKUP_TOOL: connector tool name for order lookup (e.g. glowbox_store_look_up_order)
# ZENDESK_TOOL:   connector tool name for Zendesk ticket creation (e.g. glowbox_zendesk_create_ticket)
MCP_SERVER_URL=https://your-modelguide-api.up.railway.app/mcp/agt_xxx
MCP_API_KEY=mgk_your-agent-key-here
ORDER_LOOKUP_TOOL=your_store_look_up_order
ZENDESK_TOOL=your_zendesk_create_ticket

# Logging
LOG_LEVEL=info
