# Agent worker identity — must match the LiveKit `agent_name` your
# ModelGuide agent is configured to dispatch to (see the LiveKit card on the
# agent detail page in the dashboard).
AGENT_NAME=voiceblox-prototype

# LiveKit (for local dev `livekit-server --dev` uses devkey/secret; on
# LiveKit Cloud these are injected automatically and can be omitted).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# OpenAI LLM
OPENAI_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4.1-mini

# Deepgram STT
DEEPGRAM_API_KEY=your-deepgram-key
# STT_MODEL=nova-3

# ElevenLabs TTS
ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=iP95p4xoKVk53GoZ742B

# ModelGuide — the agent fetches its compiled prompt from this API on
# every session start. The API key is the `mgk_...` shown once when the
# agent was created in the dashboard.
MODELGUIDE_API_URL=http://localhost:3000
MODELGUIDE_API_KEY=mgk_your-agent-key-here

# Optional: override the spoken greeting. Must include {name}.
# VOICEBLOX_GREETING=Hey {name} — how can I help?
