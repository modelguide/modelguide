# Daily.co WebRTC transport
DAILY_API_KEY=your-daily-api-key

# OpenAI LLM
OPENAI_API_KEY=sk-your-openai-key

# Deepgram STT
DEEPGRAM_API_KEY=your-deepgram-key

# TTS provider: "cartesia" (default) or "elevenlabs"
TTS_PROVIDER=cartesia

# Cartesia TTS
CARTESIA_API_KEY=your-cartesia-key
CARTESIA_VOICE_ID=

# ElevenLabs TTS (fallback)
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=

# ModelGuide
# Base URL of your ModelGuide API (no trailing slash)
MODELGUIDE_API_URL=http://localhost:3000
# Agent API key (mgk_xxx) — shown once at agent creation
MODELGUIDE_API_KEY=mgk_your-agent-key-here
# Agent UUID — find in the dashboard or API
MODELGUIDE_AGENT_ID=agt_xxx
# Customer email for demo (hardcoded for now)
USER_EMAIL=demo@buildpro.com

# --- Observability (Langfuse via OpenTelemetry) ---
# Tracing is enabled automatically when LANGFUSE_PUBLIC_KEY is set
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
# Optional: defaults to https://cloud.langfuse.com
# US: https://us.cloud.langfuse.com  Self-hosted: http://localhost:3000
LANGFUSE_HOST=https://cloud.langfuse.com
